// KGB Zombie Infection 0.2.0 experience candidate (requires fresh live QA).
// Copy to addons/amxmodx/configs/kgb_zombie_infection.cfg.
// Requires ReGameDLL_CS + ReAPI. No custom maps, models or sounds required.
// The plugin exclusively owns round outcomes and respawns.
mp_round_infinite "1"
mp_autoteambalance "0"
mp_limitteams "0"
mp_friendlyfire "0"
mp_freeforall "0"
mp_forcerespawn "0"
mp_freezetime "0"
mp_buytime "0"
mp_give_player_c4 "0"
mp_weapons_allow_map_placed "0"
mp_weapondrop "0"
mp_nadedrops "0"
mp_infinite_ammo "2"
mp_infinite_grenades "0"
mp_refill_bpammo_weapons "0"
sv_maxspeed "350"

kgb_zi_min_players "2"
kgb_zi_infection_delay "15.0"
kgb_zi_survival_time "180.0"
kgb_zi_zombie_ratio "0.20"
kgb_zi_zombie_health "3000"
kgb_zi_zombie_speed "300.0"
kgb_zi_zombie_gravity "0.80"
kgb_zi_human_health "100"
kgb_zi_human_armor "50"
kgb_zi_respawn_delay "3.0"
// Humans choose one stock primary (+ USP/knife) per round, before infection.
// Keep both at 0 for the original automatic M4A1/USP loadout without a menu.
kgb_zi_weapon_menu "1"
kgb_zi_auto_weapon_menu "1"
// Grants stock goggles; N toggles vision. No custom effect/assets.
kgb_zi_zombie_nightvision "1"
kgb_zi_display_name "Zombie Infection"
kgb_zi_chat_prefix "[Zombie Infection]"
